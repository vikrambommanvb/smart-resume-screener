# ==============================================================================
# Smart Resume Screener API — Production Environment Configuration (.env)
# ==============================================================================

# Application & Environment Runtime
ENVIRONMENT=production
HOST=0.0.0.0
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS) Allowlist
# Accepts JSON array or comma-separated URLs
# Use ["*"] to allow all clients, or specify your production frontend domain:
# e.g., ["https://smart-resume-screener.vercel.app", "https://your-app.onrender.com"]
ALLOWED_ORIGINS=["*"]

# Google Gemini API Settings (Obtain key from: https://aistudio.google.com/app/apikey)
# If omitted or left empty, the application runs gracefully in deterministic degraded mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=["gemini-3.5-flash", "gemini-3.8-flash"]

# Concurrency & In-Memory Resource Bounds
# Recommended: Set to 1 on Render Free tier (512 MB RAM) to prevent OOM
MAX_GLOBAL_CONCURRENT_ANALYSES=1
RATE_LIMIT_PER_10MIN=10

# Cloudflare Turnstile Bot Defense (Optional - set to false unless configured)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
